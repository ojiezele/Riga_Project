PORT=3000
JWT_SECRET=riga_saas_secret_key_99

# Neon PostgreSQL Database URL (e.g. postgres://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# Fallback individual PostgreSQL / Cloud SQL variables if not using DATABASE_URL
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Cloudflare R2 Object Storage Credentials (for lightning-fast <10ms store edge publishing)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=riga-production-bucket
R2_PUBLIC_DOMAIN=riga.site