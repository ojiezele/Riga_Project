# Server Configuration
PORT=3000

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Relational PostgreSQL Database (Managed Cloud SQL Developer Edition)
# The runtime automatically injects SQL_HOST, SQL_DB_NAME, SQL_USER, and SQL_PASSWORD.
# For schema management (Drizzle Kit), SQL_ADMIN_USER and SQL_ADMIN_PASSWORD are provided.
SQL_HOST=/cloudsql/project:region:instance
SQL_DB_NAME=postgres
SQL_USER=app_user
SQL_PASSWORD=app_password
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=admin_password
